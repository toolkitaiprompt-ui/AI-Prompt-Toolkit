{
  "name": "ai-prompt-toolkit",
  "version": "2.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-prompt-seo.mjs",
    "build": "npm run validate:sitemap && vite build && node prerender.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-rss.mjs && node scripts/validate-sitemap.mjs dist/public/sitemap.xml",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate:sitemap": "node scripts/validate-sitemap.mjs public/sitemap.xml"
  },
  "dependencies": {
    "framer-motion": "^12.23.22",
    "lucide-react": "^0.525.0",
    "pdfjs-dist": "6.2.108",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "fast-xml-parser": "^5.10.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
