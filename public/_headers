/sitemap.xml
  Content-Type: application/xml; charset=UTF-8
  Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff

/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/images/*
  Cache-Control: public, max-age=604800
  X-Content-Type-Options: nosniff

/favicon.svg
  Cache-Control: public, max-age=604800
  X-Content-Type-Options: nosniff

/rss.xml
  Content-Type: application/xml; charset=UTF-8
  Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff

/* 
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self' data: blob:; style-src 'self' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; img-src 'self' https://images.unsplash.com data:; connect-src 'self'; upgrade-insecure-requests; base-uri 'self